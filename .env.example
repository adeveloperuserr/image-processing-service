# Copia este archivo como .env y reemplaza estos valores locales.
SQLSERVER_PASSWORD=LocalOnly-Replace-Me-9vQ!3k
JWT_SECRET=local-only-replace-with-a-random-secret-of-at-least-32-characters

# Normalmente deja la pausa en cero. Para demostrar la recuperación,
# usa 30 y una reserva corta. Detén el worker durante la pausa para simular la caída.
WORKER_DEMO_PAUSE_SECONDS=0
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
